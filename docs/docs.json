{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ink",
  "description": "Build small, fast Light Phone III apps with TypeScript.",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#737373"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Public Sans"
  },
  "logo": {
    "light": "/images/title-light.png",
    "dark": "/images/title-dark.png"
  },
  "favicon": {
    "light": "/images/favicon-light.svg",
    "dark": "/images/favicon-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "project-structure"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "permissions-guide"
        ]
      },
      {
        "group": "Ink Components",
        "pages": [
          "screens",
          "text",
          "buttons",
          "text-input",
          "fields",
          "toggles",
          "selection",
          "images",
          "icons",
          "rows",
          "lists",
          "reordering",
          "screen-states",
          "confirmation",
          "playing-screen",
          "video",
          "conversations",
          "media-picker",
          "codes",
          "maps"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "navigation",
          "data"
        ]
      },
      {
        "group": "Modules",
        "pages": [
          "audio",
          "auth",
          "background",
          "barcode",
          "camera",
          "clipboard",
          "crypto",
          "files",
          "light-sdk",
          "location",
          {
            "group": "Network",
            "pages": [
              "network",
              "connectivity",
              "downloads"
            ]
          },
          "nfc",
          "notifications",
          "secure-store",
          "store"
        ]
      },
      {
        "group": "Contributing and internals",
        "pages": [
          "architecture"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/vandamd/ink",
        "label": "GitHub"
      }
    ]
  },
  "redirects": [
    {
      "source": "/components",
      "destination": "/screens"
    },
    {
      "source": "/inputs",
      "destination": "/text-input"
    }
  ]
}
