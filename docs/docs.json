{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ink",
  "description": "Build small, fast Light Phone III apps with TypeScript.",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#737373"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Public Sans"
  },
  "logo": {
    "light": "/images/title-light.png",
    "dark": "/images/title-dark.png"
  },
  "favicon": {
    "light": "/images/favicon-light.svg",
    "dark": "/images/favicon-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "standalone",
          "development"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "ink",
          "runtime-compatibility"
        ]
      },
      {
        "group": "Modules",
        "pages": [
          "audio",
          "auth",
          "background",
          "barcode",
          "camera",
          "clipboard",
          "files",
          "light-sdk",
          "location",
          "maps",
          {
            "group": "Network",
            "pages": [
              "network",
              "connectivity",
              "downloads"
            ]
          },
          "nfc",
          "notifications",
          "secure-store",
          "store"
        ]
      },
      {
        "group": "Framework",
        "pages": [
          "product-design",
          "architecture",
          "build-contracts",
          "runtime-contracts",
          "agent-tools"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/vandamd/ink",
        "label": "GitHub"
      }
    ]
  }
}
