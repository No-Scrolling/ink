#!/bin/sh

script="$0"
while [ -L "$script" ]; do
  directory=$(cd -P "$(dirname "$script")" && pwd)
  script=$(readlink "$script")
  case "$script" in
    /*) ;;
    *) script="$directory/$script" ;;
  esac
done

repository=$(cd -P "$(dirname "$script")/.." && pwd)
exec cargo +1.96.0 run --quiet --manifest-path "$repository/Cargo.toml" -p ink-cli -- "$@"
