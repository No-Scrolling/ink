{
  "name": "ink-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/light-template",
    "examples/counter",
    "docs"
  ],
  "scripts": {
    "check": "tsc -p packages/ink/tsconfig.json",
    "test": "bun ./test/run.ts",
    "bench": "bun ./test/performance/run.ts",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "docs:validate": "bun run --cwd docs validate"
  },
  "devDependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@oxlint/plugins": "1.79.0",
    "@types/react": "19.2.18",
    "@types/react-reconciler": "0.33.0",
    "oxc-parser": "0.149.0",
    "oxc-transform-react": "0.149.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "react-refresh": "0.18.0",
    "typescript": "5.9.3"
  }
}
