+declare function require(path: string): unknown;
+const names = ["Blob", "File", "FormData", "ReadableStream", "WritableStream", "TransformStream", "ByteLengthQueuingStrategy", "CountQueuingStrategy", "WebSocket", "MessageEvent", "CloseEvent", "URL", "URLSearchParams", "fetch", "Headers", "Request", "Response"];
+for (const name of names) {
+  Object.defineProperty(globalThis, name, {
+    configurable: true,
+    get() {
+      require("./web");
+      return Reflect.get(globalThis, name);
+    },
+    set(value) {
+      Object.defineProperty(globalThis, name, { value, writable: true, configurable: true });
+    },
+  });
+}
