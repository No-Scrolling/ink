+private class ProfileDataSource(private val source: DataSource) : DataSource by source {
+  private var bytes = 0L
+  private var readNs = 0L
+  private var maxReadNs = 0L
+  private var reads = 0
+  private var nextReport = 1L
+  override fun open(spec: DataSpec): Long {
+    val started = System.nanoTime()
+    val wall = System.currentTimeMillis()
+    val result = source.open(spec)
+    android.util.Log.i("ReverbLoading", "open wallMs=$wall durationUs=${(System.nanoTime()-started)/1000} position=${spec.position} length=$result")
+    return result
+  }
+  override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+    val started = System.nanoTime()
+    val count = source.read(buffer, offset, length)
+    val elapsed = System.nanoTime()-started
+    readNs += elapsed
+    maxReadNs = maxOf(maxReadNs, elapsed)
+    reads++
+    if (count > 0) bytes += count
+    if (bytes >= nextReport || count == -1) {
+      android.util.Log.i("ReverbLoading", "read wallMs=${System.currentTimeMillis()} bytes=$bytes reads=$reads totalUs=${readNs/1000} maxUs=${maxReadNs/1000} eof=${count == -1}")
+      nextReport = if (nextReport == 1L) 131072L else nextReport + 1048576L
+    }
+    return count
+  }
+  override fun close() {
+    android.util.Log.i("ReverbLoading", "close bytes=$bytes reads=$reads totalUs=${readNs/1000}")
+    source.close()
+  }
+}
+
+private class ProfileExtractor(private val extractor: Extractor) : Extractor by extractor {
+  private var reads = 0
+  private var readNs = 0L
+  override fun sniff(input: ExtractorInput): Boolean {
+    val started = System.nanoTime()
+    val result = extractor.sniff(input)
+    android.util.Log.i("ReverbLoading", "sniff type=${extractor.javaClass.simpleName} match=$result durationUs=${(System.nanoTime()-started)/1000} wallMs=${System.currentTimeMillis()}")
+    return result
+  }
+  override fun read(input: ExtractorInput, position: PositionHolder): Int {
+    val started = System.nanoTime()
+    val result = extractor.read(input, position)
+    readNs += System.nanoTime()-started
+    reads++
+    if (reads == 1 || reads % 2048 == 0) android.util.Log.i("ReverbLoading", "extract reads=$reads totalUs=${readNs/1000} position=${input.position} wallMs=${System.currentTimeMillis()}")
+    return result
+  }
+}
