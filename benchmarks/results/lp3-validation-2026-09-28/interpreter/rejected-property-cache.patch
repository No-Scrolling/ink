+static inline JSShapeProperty *find_cached_property(JSRuntime *rt,
+                                                    JSProperty **ppr,
+                                                    JSObject *p, JSAtom atom)
+{
+    uint32_t *cached = &rt->property_indices[atom & 255];
+    uint32_t index = *cached;
+    JSShape *sh = p->shape;
+    JSShapeProperty *properties = get_shape_prop(sh);
+    JSShapeProperty *property;
+
+    if (atom != JS_ATOM_NULL && index < (uint32_t)sh->prop_count && properties[index].atom == atom) {
+        *ppr = &p->prop[index];
+        return &properties[index];
+    }
+    property = find_own_property(ppr, p, atom);
+    if (property)
+        *cached = property - properties;
+    return property;
+}
